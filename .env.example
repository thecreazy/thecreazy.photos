# Where the photo variants are served from (no trailing slash). Required for production builds (the build fails without it).
# Use /photos to serve public/photos locally. The CSP in vercel.json names this origin: run `pnpm headers` after changing it.
PUBLIC_PHOTO_BASE_URL=https://photos-riccardo.fra1.cdn.digitaloceanspaces.com

# Public address of the site: canonical URLs, sitemap, Open Graph. Optional (default below).
# SITE_URL=https://photos.canellariccardo.it
