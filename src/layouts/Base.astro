---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/covered-by-your-grace/400.css';
import '@fontsource/nanum-pen-script/400.css';
import '../styles/tokens.css';
import { t } from '../i18n/en';

interface Props { title?: string; description?: string; noindex?: boolean; bodyClass?: string; htmlClass?: string; image?: string; imageAlt?: string }
const { title, description, noindex = false, bodyClass, htmlClass, image = '/og/site.jpg', imageAlt = `${t.brand} — ${t.brandSub}` } = Astro.props;
const full = title ? `${title} — ${t.brand}` : `${t.brand} — Photography`;
const site = Astro.site ?? new URL('https://photos.canellariccardo.it');
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
---
<!doctype html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{full}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={t.brand} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={full} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class={bodyClass}><slot /></body>
</html>
