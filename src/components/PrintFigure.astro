---
import { photoUrl, WIDTHS, type Shooting } from '../lib/shooting';
import { rng, hashStr } from '../lib/rng';
import { t } from '../i18n/en';

interface Props { shooting: Shooting; index: number; class?: string; eager?: boolean }
const { shooting: s, index, class: cls = '', eager = false } = Astro.props;
const file = s.photos[index - 1];
const m = s.meta[file];
const seed = hashStr(s.slug) % 100;
const rot = ((rng(seed + index * 13)() - 0.5) * 2.6).toFixed(2);
const depth = (0.03 + rng(seed + index * 5)() * 0.09).toFixed(3);
const sizes = '(max-width: 760px) 86vw, 68vw';
const set = (ext: 'avif' | 'webp') => WIDTHS.map((w) => `${photoUrl(s.slug, file, w, ext)} ${w}w`).join(', ');
---
<figure
  class:list={['print', cls, m?.portrait && 'port']}
  data-i={index}
  data-full={photoUrl(s.slug, file, 2200, 'webp')}
  data-depth={depth}
  style={`--rot:${rot}deg`}
>
  <picture>
    <source type="image/avif" srcset={set('avif')} sizes={sizes} />
    <source type="image/webp" srcset={set('webp')} sizes={sizes} />
    <img
      src={photoUrl(s.slug, file, 1400, 'webp')}
      width={m?.w ?? 3}
      height={m?.h ?? 2}
      alt={t.project.alt(s.name, index)}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </picture>
</figure>
