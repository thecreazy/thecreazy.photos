---
import { t } from '../i18n/en';
const sizes = '(max-width: 760px) 86vw, min(86vw, 1180px)'; // the print is scaled up as it leaves the envelope
---
<picture>
  <source type="image/avif" srcset="/me/self-800.avif 800w, /me/self-1200.avif 1200w" sizes={sizes} />
  <source type="image/webp" srcset="/me/self-800.webp 800w, /me/self-1200.webp 1200w" sizes={sizes} />
  <img src="/me/self-1200.webp" width="1200" height="804" alt={t.contact.selfAlt} fetchpriority="high" decoding="async" />
</picture>
