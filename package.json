{
  "name": "photos-thecreazy",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node tools/check.mjs",
    "build": "astro build",
    "check": "node tools/check.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "astro preview",
    "astro": "astro",
    "foto": "tsx tools/foto.mjs",
    "masters": "tsx tools/fetch-masters.mjs",
    "redirects": "node tools/redirects.mjs",
    "headers": "node tools/headers.mjs",
    "hashnames": "node tools/hashnames.mjs",
    "favicon": "node tools/favicon.mjs",
    "textures": "tsx tools/textures.mjs",
    "upload": "rclone copy public/photos canellariccardo:photos-riccardo --s3-acl public-read --s3-no-check-bucket --header-upload \"Cache-Control: public, max-age=31536000, immutable\" --progress",
    "migrate": "tsx tools/migrate.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/covered-by-your-grace": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "astro": "^7.4.2",
    "blurhash": "^2.0.5",
    "lenis": "1.3.25",
    "sharp": "^0.35.5",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/three": "0.160.0",
    "cheerio": "^1.2.0",
    "satori": "^0.63.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
